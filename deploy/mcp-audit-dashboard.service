[Unit]
Description=Owner-only read-only MCP audit dashboard
After=network.target

[Service]
Type=simple
User=mcp-audit
Group=mcp-audit
EnvironmentFile=/etc/mcp-audit/dashboard.env
UMask=0077
RuntimeDirectory=mcp-audit
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/mcp-audit-dashboard/current/scripts/run-mcp-audit-dashboard.py --unix-socket /run/mcp-audit/http.sock --claude-db /var/lib/mcp-audit/claude.sqlite3 --gemini-db /var/lib/mcp-audit/gemini.sqlite3 --health-snapshot /var/lib/mcp-audit/health.json
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
MemoryMax=128M
CPUQuota=25%
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/run/mcp-audit

[Install]
WantedBy=multi-user.target
